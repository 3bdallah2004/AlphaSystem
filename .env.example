# Copy this file to .env and fill in the values:
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# Never commit .env — it holds your secrets.

# ── AI model (used by the n8n analysis workflow) ──────────────────────────────
# Any OpenAI-compatible Chat Completions API works. Required for case analysis.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# ── Vision model: reads attached images and video frames for the analysis ─────
# The analysis model above is usually text-only, so a model that accepts images describes the
# attachments first and its description joins the report. Reuses LLM_API_KEY/LLM_BASE_URL when
# VISION_API_KEY / VISION_BASE_URL are left empty.
# OpenRouter free option that accepts images and video:
VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
# VISION_BASE_URL=https://openrouter.ai/api/v1
# VISION_API_KEY=
# Set to 0 to keep attachments out of the analysis entirely.
ALPHA_VISION_ENABLED=1
# Audio and video audio-track transcription endpoint model. The provider must support
# OpenAI-compatible /audio/transcriptions.
ALPHA_AUDIO_TRANSCRIPTION_MODEL=whisper-1
# A reasoning vision model can spend its whole reply budget thinking and answer nothing; the
# second call below is the retry with a bigger budget.
# ALPHA_VISION_MAX_TOKENS=1200
# ALPHA_VISION_RETRY_MAX_TOKENS=3000

# Other providers (uncomment one pair and set LLM_API_KEY accordingly):
# Google Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                 LLM_MODEL=gemini-2.5-flash
# Anthropic:      LLM_BASE_URL=https://api.anthropic.com/v1
#                 LLM_MODEL=claude-sonnet-5-5
# Groq:           LLM_BASE_URL=https://api.groq.com/openai/v1
#                 LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter:     LLM_BASE_URL=https://openrouter.ai/api/v1
#                 LLM_MODEL=openai/gpt-4.1-mini
# Ollama (local, no key needed — put any text in LLM_API_KEY):
#                 LLM_BASE_URL=http://host.docker.internal:11434/v1
#                 LLM_MODEL=llama3.1

# ── Automatic map location ────────────────────────────────────────────────────
# The location name from a report is turned into map coordinates with OpenStreetMap's
# Nominatim. Only the place name is sent there, never the report text. Set to 0 to turn it off.
# ALPHA_GEOCODE_ENABLED=1
# ALPHA_GEOCODE_URL=https://nominatim.openstreetmap.org/search
# The region whose places are preferred in a search ("Jenin" the West Bank city, not the Polish
# village): "north,west;south,east". Leave empty for no bias.
# ALPHA_GEOCODE_BOUNDS=33.4,34.2;31.2,35.9

# ── PostgreSQL (n8n's database) ───────────────────────────────────────────────
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=n8n

# ── General ───────────────────────────────────────────────────────────────────
TIMEZONE=UTC
# Ports on your machine (only reachable from this computer).
APP_PORT=8501
N8N_PORT=5678
# Seconds to wait for an analysis before giving up.
ALPHA_REQUEST_TIMEOUT=120

# ── Only when running the app without Docker (python/streamlit directly) ─────
# ALPHA_WEBHOOK_URL=http://localhost:5678/webhook/alpha-analyze
# ALPHA_DB_PATH=data/alpha_database.db
